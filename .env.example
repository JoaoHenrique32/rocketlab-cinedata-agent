# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelos :free em ordem de fallback (lista JSON). Confira os disponíveis em
# https://openrouter.ai/api/v1/models — o catálogo :free muda com frequência.
# LLM_MODELS=["google/gemma-4-31b-it:free","nvidia/nemotron-3-super-120b-a12b:free","qwen/qwen3.8-27b:free"]

# Banco da camada Gold (caminho relativo à raiz do projeto)
DB_PATH=data/cinerocket.db

# Limites de execução
QUERY_TIMEOUT_S=30
MAX_ROWS=200
LLM_TIMEOUT_S=60

# Quota diária do tier :free e cache local
DAILY_REQUEST_LIMIT=50
QUOTA_WARNING_AT=40
CACHE_PATH=.cache/agent_cache.db
